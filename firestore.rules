rules_version = '2';
// খেলাঘর ডেটাবেসের নিরাপত্তা নিয়ম।
// Firebase Console → Firestore Database → Rules ট্যাবে পুরোটা পেস্ট করে Publish চাপুন।
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function bonus() { return get(/databases/$(database)/documents/config/bonus).data; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['ismail392594@gmail.com'];
    }

    // খেলোয়াড়ের প্রোফাইল ও পয়েন্ট
    match /users/{uid} {
      allow read: if signedIn();
      // নতুন একাউন্ট: শুধু নিজের, ৫০০ পয়েন্ট দিয়ে শুরু, ইউজারনেম আগে থেকে নিজের নামে বুক করা থাকতে হবে
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username','name','points','games','wins','createdAt','lastDaily'])
        && request.resource.data.points == 500
        && request.resource.data.games == 0
        && request.resource.data.wins == 0
        && request.resource.data.lastDaily == null
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == request.auth.uid;
      // অ্যাডমিন যেকোনো পয়েন্ট বদলাতে পারে।
      // খেলোয়াড় নিজে শুধু দৈনিক বোনাস (+১০০) নিতে পারে, ২০ ঘণ্টায় একবার।
      // অ্যাডমিন যেকোনো কিছু বদলাতে পারে। খেলোয়াড় নিজে শুধু:
      // (১) দৈনিক বোনাস +১০০, ২০ ঘণ্টায় একবার
      // (২) বোনাস মিশন (টেলিগ্রাম / ফেসবুক শেয়ার), প্রতিটা একবার, অ্যাডমিন চালু রাখলে, অ্যাডমিনের ঠিক করা পরিমাণে
      allow update: if isAdmin() || (
        signedIn() && request.auth.uid == uid && resource.data.get('banned', false) != true && (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','lastDaily'])
            && request.resource.data.points == resource.data.points + 100
            && request.resource.data.lastDaily == request.time
            && (resource.data.lastDaily == null || request.time > resource.data.lastDaily + duration.value(20, 'h'))
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','tgDone'])
            && resource.data.get('tgDone', false) == false
            && request.resource.data.tgDone == true
            && bonus().tgOn == true
            && request.resource.data.points == resource.data.points + bonus().tgAmount
          ) || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['points','fbDone'])
            && resource.data.get('fbDone', false) == false
            && request.resource.data.fbDone == true
            && bonus().fbOn == true
            && request.resource.data.points == resource.data.points + bonus().fbAmount
          )
        )
      );
      allow delete: if false;
    }

    // খেলোয়াড়ের ব্যক্তিগত তথ্য (Gmail, ফোন): শুধু সে নিজে আর অ্যাডমিন দেখবে
    match /private/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email','phone','updatedAt'])
        && request.resource.data.email == request.auth.token.email
        && (request.resource.data.phone == null || (request.resource.data.phone is string && request.resource.data.phone.matches('^01[3-9][0-9]{8}$')));
      allow delete: if isAdmin();
    }

    // ইউজারনেম যাতে দুইজন একই না পায়
    match /usernames/{name} {
      allow read: if signedIn();
      // শুধু একাউন্ট খোলার সময় একবার (আগে এক জন অনেক নাম আটকে রাখতে পারত)
      allow create: if signedIn()
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && name.matches('^[a-z0-9_]{3,15}$')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // বন্ধুকে খেলার দাওয়াত
    match /invites/{id} {
      allow read: if signedIn() && (resource.data.to == request.auth.uid || resource.data.from == request.auth.uid);
      allow create: if signedIn() && request.resource.data.from == request.auth.uid && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['from','fromName','fromUser','to','toUser','game','room','status','createdAt'])
        && request.resource.data.to is string && request.resource.data.to != request.auth.uid
        && request.resource.data.fromUser == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.username;
      allow update: if signedIn() && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status in ['accepted','declined'];
      allow delete: if signedIn() && resource.data.from == request.auth.uid;
    }

    // খেলার রুম
    match /rooms/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.host == request.auth.uid
        && request.resource.data.keys().hasOnly(['game','max','host','status','createdAt','uids','players'])
        && request.resource.data.status == 'waiting'
        && request.resource.data.max is int && request.resource.data.max >= 2 && request.resource.data.max <= 4
        && request.resource.data.uids == [request.auth.uid]
        && request.resource.data.players.size() == 1 && request.resource.data.players[0].uid == request.auth.uid;
      // খেলার অবস্থা (matchId, ক্যারমের cm) শুধু সার্ভার লেখে। খেলোয়াড় শুধু নিজেকে শেষের খালি সিটে যোগ করতে পারে,
      // অন্যদের নাম বা সিট বদলাতে পারে না।
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players','uids'])
        && resource.data.status == 'waiting'
        && !(request.auth.uid in resource.data.uids)
        && request.resource.data.uids.size() == resource.data.uids.size() + 1
        && request.resource.data.uids.size() <= resource.data.max
        && request.resource.data.uids[0:resource.data.uids.size()] == resource.data.uids
        && request.resource.data.uids[resource.data.uids.size()] == request.auth.uid
        && request.resource.data.players.size() == resource.data.players.size() + 1
        && request.resource.data.players[0:resource.data.players.size()] == resource.data.players
        && request.resource.data.players[resource.data.players.size()].uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.host == request.auth.uid;
    }

    // লুডুর খেলা: শুধু খেলোয়াড়রা দেখতে পারে, বদলাতে পারে শুধু সার্ভার
    match /matches/{id} {
      allow read: if signedIn() && request.auth.uid in resource.data.uids;
      allow write: if false;
    }

    // গেমের সেরা স্কোর (যেমন মশা মারো): নিজের স্কোর শুধু বাড়ানো যায়।
    // নাম-ইউজারনেম নিজের প্রোফাইলের সাথে মিলতে হবে (অন্যের নামে স্কোর দেওয়া যাবে না),
    // সময় সার্ভারের সময়, আর ৩০ সেকেন্ডে একবারের বেশি না (স্ক্রিপ্ট দিয়ে বারবার পাঠানো বন্ধ)।
    match /scores/{game}/players/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && game.matches('^[a-z0-9]{2,20}$')
        && request.resource.data.keys().hasOnly(['score','name','username','at'])
        && request.resource.data.score is int && request.resource.data.score > 0 && request.resource.data.score <= 100000
        && request.resource.data.at == request.time
        && get(/databases/$(database)/documents/users/$(uid)).data.get('banned', false) != true
        && request.resource.data.username == get(/databases/$(database)/documents/users/$(uid)).data.username
        && request.resource.data.name == get(/databases/$(database)/documents/users/$(uid)).data.name
        && (resource == null || (request.resource.data.score > resource.data.score && request.time > resource.data.at + duration.value(30, 's')));
      allow delete: if isAdmin();
    }

    // সাইটের সেটিং (ঘোষণা, যোগাযোগের তথ্য) আর গেমের অবস্থা: সবাই পড়বে, শুধু অ্যাডমিন বদলাবে
    match /config/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // অ্যাডমিন পাসওয়ার্ডের গোপন হ্যাশ: শুধু অ্যাডমিন Gmail পড়তে-লিখতে পারবে
    match /admin/{id} {
      allow read, write: if isAdmin();
    }

    // খেলোয়াড়দের বার্তা (যোগাযোগ)
    match /messages/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid','username','name','topic','text','createdAt','status','reply','repliedAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.reply == null
        && request.resource.data.createdAt == request.time;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }
  }
}
